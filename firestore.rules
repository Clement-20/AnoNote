rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anonymous chat app security rules
    match /users/{userId} {
      allow read, write: if true;
      
      match /drafts/{chatId} {
        allow read, write: if true;
      }
    }
    
    match /drafts/{draftId} {
      allow read, write: if true;
    }
    
    match /chats/{chatId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    match /broadcasts/{broadcastId} {
      allow read, write: if true;
    }
  }
}
